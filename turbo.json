{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ],
      "env": [
        "VITE_PLAINVA_GOOGLE_MAIL_STATE",
        "VITE_PLAINVA_GOOGLE_DESKTOP_CLIENT_ID",
        "VITE_PLAINVA_GOOGLE_DESKTOP_CLIENT_SECRET",
        "VITE_PLAINVA_GOOGLE_IOS_CLIENT_ID",
        "VITE_PLAINVA_GOOGLE_ANDROID_CLIENT_ID"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "PLAINVA_TEST_WORKERS"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
