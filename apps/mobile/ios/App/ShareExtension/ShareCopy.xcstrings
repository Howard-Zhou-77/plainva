{
  "sourceLanguage": "en",
  "strings": {
    "receiving": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilte Inhalte werden gesichert…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving shared content…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando contenido compartido…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement du contenu partagé…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio dei contenuti condivisi…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された内容を保存しています…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedeelde inhoud opslaan…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywanie udostępnionej zawartości…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando conteúdo compartilhado…"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存共享内容…"
          }
        }
      }
    },
    "saved": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gespeichert. Öffne Plainva, um Vault und Zielordner zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on this device. Open Plainva to choose the vault and folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en este dispositivo. Abre Plainva para elegir el vault y la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré sur cet appareil. Ouvrez Plainva pour choisir le vault et le dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato sul dispositivo. Apri Plainva per scegliere vault e cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に保存しました。Plainvaを開いてVaultとフォルダーを選択してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit apparaat opgeslagen. Open Plainva om de vault en map te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano na tym urządzeniu. Otwórz Plainva, aby wybrać vault i folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo neste dispositivo. Abra o Plainva para escolher o vault e a pasta."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存在此设备上。请打开 Plainva，选择 Vault 和文件夹。"
          }
        }
      }
    },
    "failed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht vollständig gespeichert. Bitte teile die ursprünglichen Inhalte erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not fully saved. Please share the original content again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado por completo. Comparte de nuevo los originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement incomplet. Partagez à nouveau le contenu original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio incompleto. Condividi di nuovo i contenuti originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存が完了していません。元の内容をもう一度共有してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet volledig opgeslagen. Deel de oorspronkelijke inhoud opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zapisano całości. Udostępnij oryginalną zawartość ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi salvo por completo. Compartilhe o conteúdo original novamente."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未完整保存。请重新共享原始内容。"
          }
        }
      }
    },
    "limit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens 10 Dateien, 25 MiB pro Datei, 50 MiB insgesamt und 512 KiB Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most 10 files, 25 MiB per file, 50 MiB in total and 512 KiB of text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo 10 archivos, 25 MiB por archivo, 50 MiB en total y 512 KiB de texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au maximum 10 fichiers, 25 Mio par fichier, 50 Mio au total et 512 Kio de texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Massimo 10 file, 25 MiB per file, 50 MiB in totale e 512 KiB di testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大10ファイル、1ファイル25 MiB、合計50 MiB、テキスト512 KiBまでです。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal 10 bestanden, 25 MiB per bestand, 50 MiB in totaal en 512 KiB tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalnie 10 plików, 25 MiB na plik, 50 MiB łącznie i 512 KiB tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo 10 arquivos, 25 MiB por arquivo, 50 MiB no total e 512 KiB de texto."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 10 个文件，每个文件 25 MiB，总计 50 MiB，文本 512 KiB。"
          }
        }
      }
    },
    "full": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warteschlange ist voll. Übernimm oder verwirf zuerst wartende Inhalte in Plainva."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The queue is full. Import or discard waiting content in Plainva first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cola está llena. Primero importa o descarta contenido pendiente en Plainva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La file est pleine. Importez ou supprimez d’abord du contenu en attente dans Plainva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La coda è piena. Importa o elimina prima i contenuti in attesa in Plainva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機領域がいっぱいです。先にPlainvaで待機中の内容を取り込むか破棄してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wachtrij is vol. Importeer of verwijder eerst wachtende inhoud in Plainva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejka jest pełna. Najpierw zaimportuj lub odrzuć oczekującą zawartość w Plainva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fila está cheia. Primeiro importe ou descarte conteúdo pendente no Plainva."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "队列已满。请先在 Plainva 中导入或丢弃待处理的内容。"
          }
        }
      }
    },
